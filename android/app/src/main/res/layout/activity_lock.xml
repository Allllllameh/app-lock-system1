<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:padding="24dp">
    <ImageView android:id="@+id/lockIcon" android:layout_width="80dp" android:layout_height="80dp" android:src="@android:drawable/ic_lock_lock" app:tint="@color/danger" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="100dp"/>
    <TextView android:id="@+id/lockTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="این برنامه قفل است" android:textColor="@color/text_main" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/lockIcon" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/lockDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="رمز دسترسی را از مدیر بگیرید و وارد کنید" android:textColor="@color/text_muted" android:textSize="14sp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/lockTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/codeLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:hint="رمز دسترسی" app:boxStrokeColor="@color/primary" app:hintTextColor="@color/primary" app:layout_constraintTop_toBottomOf="@id/lockDesc">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textAlignment="center" android:textSize="24sp" android:letterSpacing="0.2" android:textColor="@color/text_main" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnUnlock" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="باز کردن" android:textSize="16sp" app:cornerRadius="16dp" app:backgroundTint="@color/success" app:layout_constraintTop_toBottomOf="@id/codeLayout" />
</androidx.constraintlayout.widget.ConstraintLayout>
